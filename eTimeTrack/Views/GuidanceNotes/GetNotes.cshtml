@using eTimeTrack.Extensions
@using eTimeTrack.ViewModels
@model GetNotesViewModel

@{
    ViewBag.Title = "Project Guidance Notes";
}

@Html.Partial("_Banner")
@Html.Partial("_InfoMessageRender")

<div class="container" style="max-width:1200px">
    <div class="alert alert-info">
        These notes are intended as a general guide for project personnel to assist in the completion of timesheets. Please contact your project’s time administrator if you need further assistance.
    </div>
    <div class="form-horizontal">
        <hr />
        <div class="form-group">
            <label class="control-label col-md-4">
                Time Administrator Contact
                <a class='tool-tip' data-toggle="tooltip" data-placement="right" title="Insert email address of eTT Time Administrator for the project">
                    <i class='glyphicon glyphicon-info-sign'></i>
                </a>
            </label>
            <div class="col-md-8">
                @Html.EditorFor(model => model.GuidanceNotes.TimeAdministratorContact, new { htmlAttributes = new { @class = "form-control", placeholder = "", style = "max-width:70%", @readonly = "readonly" } })
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-4">
                Online notes used with WBS codes
                <a class='tool-tip' data-toggle="tooltip" data-placement="right" title="Yes or No with any commentary">
                    <i class='glyphicon glyphicon-info-sign'></i>
                </a>
            </label>
            <div class="col-md-8">
                @Html.EditorFor(model => model.GuidanceNotes.WBSCodes, new { htmlAttributes = new { @class = "form-control", placeholder = "", style = "max-width:70%", @readonly = "readonly" } })
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-4">
                Cap weekly hours at
                <a class='tool-tip' data-toggle="tooltip" data-placement="right" title="Insert any hours caps and provide additional commentary">
                    <i class='glyphicon glyphicon-info-sign'></i>
                </a>
            </label>
            <div class="col-md-8">
                @Html.EditorFor(model => model.GuidanceNotes.CapWeeklyHours, new { htmlAttributes = new { @class = "form-control", placeholder = "", style = "max-width:70%", @readonly = "readonly" } })
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-4">
                Match hours to home office timesheet?
                <a class='tool-tip' data-toggle="tooltip" data-placement="right" title="Yes or no with commentary if needed">
                    <i class='glyphicon glyphicon-info-sign'></i>
                </a>
            </label>
            <div class="col-md-8">
                @Html.EditorFor(model => model.GuidanceNotes.MatchHours, new { htmlAttributes = new { @class = "form-control", placeholder = "", style = "max-width:70%", @readonly = "readonly" } })
            </div>
        </div>
